# ==============================================================================
# AKSANTARA - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini ke `.env.local` dan masukkan nilai kredensial Anda.
# JANGAN PERNAH menyertakan file `.env.local` ke dalam git repository publik.

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (WAJIB)
# ------------------------------------------------------------------------------
# Dapatkan kredensial ini di: https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# (Opsional untuk Admin Script / Server Bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. LLM API UNTUK ENRICHMENT CERITA RAKYAT / LORE BUDAYA (OPSIONAL)
# ------------------------------------------------------------------------------
# Digunakan untuk variasi dialog persona lokal (I La Galigo, Purbasari, Calon Arang).
# Jika dikosongkan, alur cerita berjalan 100% deterministik menggunakan alur JSON lokal.
GEMINI_API_KEY=your-google-gemini-api-key-here

# Alternatif LLM Provider:
# OPENAI_API_KEY=your-openai-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# ------------------------------------------------------------------------------
# 3. AI CLASSIFIER SERVING (OPSIONAL JIKA MENGGUNAKAN MICROSERVICE EXTERNAL)
# ------------------------------------------------------------------------------
# Secara default, evaluasi canvas dapat berjalan on-device via ONNX Web di folder
# `web/public/models/nusaaksara_trinitas.onnx`. Jika menggunakan server eksternal:
# NEXT_PUBLIC_AI_CLASSIFIER_URL=http://localhost:8000/predict
